@startuml Diagrama_UML_Gimnasio
' ============================================================
'  GymPro - Sistema de Administración de un Gimnasio
'  Diagrama de clases UML completo - DSOO 2026-B (UNSA)
'  Ver en: https://www.plantuml.com  o extensión PlantUML (VS Code)
'  Regenerar el SVG (plantuml.jar de https://plantuml.com/download; sin Graphviz
'  instalado se usa el motor integrado con -Playout=smetana):
'    java -jar plantuml.jar -Playout=smetana -tsvg Diagramas_UML/Diagrama_UML_Gimnasio.puml
'
'  Actualizado al Sprint 3 (v0.3). Las clases en verde ya están
'  implementadas; las blancas son el diseño de los próximos sprints.
' ============================================================
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 25
skinparam ranksep 35
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #444444
  ArrowColor #333333
}
skinparam package {
  BackgroundColor #F4F8FB
  BorderColor #7A9CC6
}
hide empty members
title GymPro - Diagrama de Clases UML (actualizado al Sprint 2, v0.2)

