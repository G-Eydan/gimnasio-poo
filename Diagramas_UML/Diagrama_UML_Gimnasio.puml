package "enums (modelo.enums)" as PE #FFF8E7 {
  enum EstadoMembresia #E8F5E9 {
    PENDIENTE
    ACTIVA
    VENCIDA
    CANCELADA
  }
  enum EstadoInscripcion #E8F5E9 {
    ACTIVO
    POR_VENCER
    VENCIDO
    SIN_MEMBRESIA
  }
  enum MetodoPago #E8F5E9 {
    EFECTIVO(0.0)
    YAPE_PLIN(0.0)
    TRANSFERENCIA(0.0)
    TARJETA(0.03)
    --
    - recargo : double
    - MetodoPago(recargo : double)
    + getRecargo() : double
  }
  enum Especialidad #E8F5E9 {
    MUSCULACION
    CARDIO
    CROSSFIT
    FUNCIONAL
    YOGA
    PILATES
    NUTRICION
    REHABILITACION
  }
  enum Turno #E8F5E9 {
    MANANA
    TARDE
    NOCHE
  }
  enum GrupoMuscular #E8F5E9 {
    PECHO
    ESPALDA
    PIERNAS
    HOMBROS
    BRAZOS
    ABDOMEN
    CUERPO_COMPLETO
    CARDIO
  }
  enum Objetivo #E8F5E9 {
    HIPERTROFIA
    FUERZA
    PERDIDA_DE_PESO
    RESISTENCIA
    TONIFICACION
  }
  enum DiaSemana #E8F5E9 {
    LUNES
    MARTES
    MIERCOLES
    JUEVES
    VIERNES
    SABADO
    DOMINGO
  }
  enum Rol #E8F5E9 {
    ADMINISTRADOR
    RECEPCIONISTA
    ENTRENADOR
  }
}


